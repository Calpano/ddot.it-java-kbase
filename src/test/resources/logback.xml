<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %.-1level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Scheduler: DEBUG shows every file; WARN fires automatically for files >200ms -->
    <logger name="com.calpano.ddot.it.indexer.Scheduler" level="DEBUG"/>

    <!-- Kbase impl: DEBUG shows pattern/query timing; milestones and slow ops log at INFO/WARN -->
    <logger name="it.ddot.core.kbase.inmem" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
